# Copy this file to .env and fill in real values. .env is gitignored and never committed.

# Leave SMTP_HOST empty to keep using Ethereal (fake test inbox, preview links only).
# Set it to switch to real email delivery — no code changes needed.

# --- SendGrid ---
# 1. Sign up at sendgrid.com (check current plans and sending limits).
# 2. Settings -> Sender Authentication -> verify a Single Sender (your own email address).
# 3. Settings -> API Keys -> create a key with "Mail Send" permission.
# 4. SMTP_USER must be the literal string "apikey" (not your SendGrid username) -
#    the actual API key goes in SMTP_PASS.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your-sendgrid-api-key-here
EMAIL_FROM=Find My Tutor <your-verified-sender@example.com>

# --- Everything below is optional; defaults shown ---
# PORT=5050
# DB_PATH=./src/data/find-my-tutor.db
# CORS_ORIGIN=*
